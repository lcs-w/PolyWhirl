import numpy as np
import numpy.typing as npt

COLUMNS: tuple[str, str, str, str, str]

class TickBuffer:
    def __init__(self, capacity: int) -> None: ...
    def push(
        self, mid: float, spread: float, imbalance: float, timestamp: int, volume: float = 0.0
    ) -> None: ...
    def extend(
        self,
        mid: npt.ArrayLike,
        spread: npt.ArrayLike,
        imbalance: npt.ArrayLike,
        timestamp: npt.ArrayLike,
        volume: npt.ArrayLike | None = None,
    ) -> None: ...
    def clear(self) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> tuple[float, float, float, int, float]: ...
    @property
    def capacity(self) -> int: ...
    @property
    def full(self) -> bool: ...
    def vwap(self, n: int) -> float: ...
    def mid_zscore(self, window: int) -> float: ...
    def imbalance_ewma(self, alpha: float) -> float: ...
    def mid_zscore_series(self, window: int) -> npt.NDArray[np.float64]: ...
    def imbalance_ewma_series(self, alpha: float) -> npt.NDArray[np.float64]: ...
    def mids(self) -> npt.NDArray[np.float64]: ...
    def spreads(self) -> npt.NDArray[np.float64]: ...
    def imbalances(self) -> npt.NDArray[np.float64]: ...
    def volumes(self) -> npt.NDArray[np.float64]: ...
    def timestamps(self) -> npt.NDArray[np.int64]: ...
    def to_numpy(self) -> npt.NDArray[np.float64]: ...
